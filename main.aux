\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Răspunsurile indică faptul că interacțiunea cu interfața aplicației a fost bine înțeleasă. 80\% dintre respondenți au declarat că au înțeles „Complet” cum să folosească meniurile.}}{47}{figure.caption.53}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.3}Nivelul de confort fizic}{48}{subsection.4.6.3}\protected@file@percent }
